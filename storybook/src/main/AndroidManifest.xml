<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SOPTMds">

        <activity
            android:name="org.sopt.official.storybook.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SOPTMds">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ThemeActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".AvatarActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ButtonActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".CalloutActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ChipActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ControlActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".DialogActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".InputActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".TagActivity"
            android:exported="false"
            android:launchMode="singleTop" />
    </application>
</manifest>